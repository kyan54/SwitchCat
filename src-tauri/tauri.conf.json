{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwitchCat",
  "version": "0.1.4",
  "identifier": "com.kyan54.switchcat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SwitchCat 设置",
        "width": 920,
        "height": 720,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "OpenWrt PassWall2 tray switcher",
    "longDescription": "SwitchCat is a lightweight tray utility for switching between local routing and OpenWrt PassWall2 nodes across multiple environments.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
